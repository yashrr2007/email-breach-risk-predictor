# Copy to .env and fill in values. All settings are optional.

# Breach data provider: XposedOrNot public API — free, NO API key needed.
# https://xposedornot.com/api_doc

# Server port (default 3000)
PORT=3000

# Outbound HTTP timeout for the breach provider, ms (default 8000)
FETCH_TIMEOUT_MS=8000

# Breach lookup cache TTL, ms (default 1800000 = 30 min)
CACHE_TTL_MS=1800000
